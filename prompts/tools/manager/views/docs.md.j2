{% set exclude = [] %}
{% if tools.parameters.manager.docs and tools.parameters.manager.docs.exclude %}
  {% for doc in tools.parameters.manager.docs.exclude %}
    {% set _ = exclude.append(doc ~ '.md') %}
  {% endfor %}
{% endif %}
{% set _ = exclude.append('index.md') %}
### View: Documentation 

{{ md(properties.paths.root + properties.paths.docs + 'index.md', { "header": 3}) }}

{% for doc in markdown(properties.paths.root + properties.paths.docs, exclude) %}
{% set doc_path = properties.paths.root + properties.paths.docs + doc %}
{{ md(doc_path, { "header": 3 }) }}

{% endfor %}