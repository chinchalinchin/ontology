flowchart LR
    subgraph Inventory ["Inventory"]
        Sheathe["Sheathe"]
        Belt["Belt"]
        Bag["Bag"]
        Pouch["Pouch"]
        Pack["Pack"]
        Sack["Sack"]
    end

    subgraph Slots ["Slots"]
        subgraph Equipment ["Equipment"]
            Armor["Armor"]
            Shield["Shield"]
            Weapon["Weapon"]
            Tool["Tool"]
            Utility["Utility"]
        end
        subgraph Grip ["Grip"]
            Left["Left"]
            Right["Right"]
        end
    end

    Sheathe -- slottable --> Weapon
    Belt -- slottable --> Tool
    Bag -- slottable --> Utility
    Pouch -- slottable --> Left
    Pouch -- slottable --> Right

    Sheathe ~~~ Armor
    Sheathe ~~~ Shield
    Pack ~~~ Right
    Sack ~~~ Right

